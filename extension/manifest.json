{
  "manifest_version": 3,
  "name": "Claude Code Inspector",
  "version": "3.1.0",
  "description": "Seleziona elementi DOM e invia prompt a Claude Code",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "notifications",
    "alarms",
    "identity",
    "identity.email",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:3132/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
